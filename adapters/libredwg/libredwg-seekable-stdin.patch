diff --git a/src/dwg.c b/src/dwg.c
index 74c284548..2ab1429b0 100644
--- a/src/dwg.c
+++ b/src/dwg.c
@@ -246,14 +246,21 @@ dwg_read_file (const char *restrict filename, Dwg_Data *restrict dwg)
   struct_stat_t attrib;
   Bit_Chain bit_chain = { 0 };
   int error;
+  int seekable_stdin = 0;
 
   loglevel = dwg->opts & DWG_OPTS_LOGLEVEL;
   memset (dwg, 0, sizeof (Dwg_Data));
   dwg->opts = loglevel;
 
   if (strEQc (filename, "-"))
     {
       fp = stdin;
+      {
+        int fd = fileno (fp);
+        if (fd >= 0 && !fstat (fd, &attrib)
+            && S_ISREG (attrib.st_mode) && attrib.st_size > 0)
+          seekable_stdin = 1;
+      }
     }
   else
     {
@@ -282,7 +290,15 @@ dwg_read_file (const char *restrict filename, Dwg_Data *restrict dwg)
   memset (&bit_chain, 0, sizeof (Bit_Chain));
   if (fp == stdin)
     {
-      error = dat_read_stream (&bit_chain, fp);
+      if (seekable_stdin)
+        {
+          bit_chain.size = attrib.st_size;
+          error = dat_read_file (&bit_chain, fp, filename);
+        }
+      else
+        {
+          error = dat_read_stream (&bit_chain, fp);
+        }
       if (error >= DWG_ERR_CRITICAL)
         return error;
     }
